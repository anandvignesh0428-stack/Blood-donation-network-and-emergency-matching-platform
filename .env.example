# Blood Donation Network - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# NEVER paste real secrets into chat - set them in the Vercel dashboard

# Database Configuration (production on Vercel MUST be PostgreSQL -
# Vercel's serverless filesystem is read-only, so SQLite cannot be used)
# PostgreSQL format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Local development alternatives (uncomment one if needed):
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/blood_donation
# DATABASE_URL=sqlite:///blood_donation.db

# Optional: extra browser origins allowed to call the API (comma-separated).
# Not needed for the built-in UI - frontend and API share the same origin.
# Example: FRONTEND_ORIGINS=https://my-other-site.com
FRONTEND_ORIGINS=